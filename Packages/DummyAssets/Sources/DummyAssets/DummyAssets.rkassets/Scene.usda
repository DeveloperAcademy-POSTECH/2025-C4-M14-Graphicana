    def "OceanPlane" (
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @EnvironmentMapV3/OceanPlane.usd@
    )
    {
        reorder nameChildren = ["OceanSpatialAudio1", "OceanSpatialAudio2", "oceanAudio", "Sea", "_materials", "env_light"]
        float2 ui:nodegraph:node:pos = (20, 20)
