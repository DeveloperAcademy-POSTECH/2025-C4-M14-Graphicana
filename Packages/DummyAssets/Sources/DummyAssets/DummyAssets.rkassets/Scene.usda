        def RealityKitAudioFile "oceanAudio"
        {
            uniform asset file = @AddSoundeffects/Sound Spark - Sea -  Wave Crashing into the Shore Splashing.wav@
            uniform token loadingStrategy = "Stream"
            uniform bool shouldLoop = 1
        }

        over "Sea"
        {
            quatf xformOp:orient = (0.9999955, -0.0004442352, -0.0020393047, 0.00214269)
